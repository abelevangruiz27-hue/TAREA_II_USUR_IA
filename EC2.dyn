    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n \r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n \r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n \r\n# Desenvolver los elementos de Dynamo a elementos nativos de Revit\r\nentrada = IN[0]\r\nif not isinstance(entrada, list):\r\n    entrada = [entrada]\r\nelementos = [UnwrapElement(e) for e in entrada]\r\n \r\nregistros = []\r\n \r\nfor el in elementos:\r\n    # Tipo de muro y su nombre\r\n    tipo = doc.GetElement(el.GetTypeId())\r\n    nombre_tipo = tipo.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString()\r\n \r\n    # Nivel base del muro\r\n    nivel_el = doc.GetElement(el.LevelId)\r\n    nivel = nivel_el.Name if nivel_el else None\r\n \r\n    registros.append({\r\n        \"Id\": el.Id.Value,\r\n        \"Nombre\": nombre_tipo,\r\n        \"Nivel\": nivel\r\n    })\r\n \r\n# Comillas simples por fuera porque el nombre incluye el símbolo \" (pulgadas)\r\nvalores_validos = ['CC b = 50cm', 'CC b=0.35cm', 'CC b=50cm', 'PL-1 (e=13 cm)', 'PL-1 (e=25 cm)', 'PL-1 (e=23 cm)', 'PL-3 (e=25 cm)', 'PL-5 (e=25 cm)', 'PL-6 (e=25 cm)', 'PL-7 (e=25 cm)', 'PL-9 (e=25 cm)', 'PL-10 (e=25 cm)', 'PL-11 (e=25 cm)', 'PL-13 (e=25 cm)', 'Sobrecimiento b = 13cm', 'Sobrecimiento b = 23cm', 'Sobrecimiento Pre Mezclado Armado b = 13cm', 'Sobrecimiento Pre Mezclado Armado b = 23cm', 'MURO DE LADRILLO KK DE ARCILLA DE SOGA CM 1_4', 'MURO DE LADRILLO KK DE ARCILLA DE CABEZA CM 1_4', 'Parapeto b = 13cm']\r\n \r\nfor r in registros:\r\n    nombre = r[\"Nombre\"].strip() if r[\"Nombre\"] else \"\"\r\n    if nombre == \"\":\r\n        r[\"Estado\"] = \"Falta parámetro\"\r\n    elif nombre not in valores_validos:\r\n        r[\"Estado\"] = \"Fuera de estándar\"\r\n    else:\r\n        r[\"Estado\"] = \"OK\"\r\n \r\nencabezados = [\"Id\", \"Nombre\", \"Nivel\", \"Estado\"]\r\nfilas = [[r[\"Id\"], r[\"Nombre\"], r[\"Nivel\"], r[\"Estado\"]]\r\n         for r in registros]\r\n \r\nOUT = [encabezados] + filas\r\n\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b3510b6f929c42009f4871763dbc1b85",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "5642eb4326c248e3aaa86b6aa8b4ea36",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4b4ff6f1b3354c578f4cdb51dd8432b5",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
